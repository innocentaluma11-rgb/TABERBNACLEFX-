COMPOSIO_API_KEY=your_api_key_here
COMPOSIO_USER_ID=user-123

# Existing GitHub demo
GITHUB_OWNER=innocentaluma11-rgb
GITHUB_REPO=TABERBNACLEFX-

# Set these only if your Composio workspace uses different toolkit names.
COMPOSIO_INSTAGRAM_TOOLKIT=instagram
COMPOSIO_TIKTOK_TOOLKIT=tiktok
COMPOSIO_YOUTUBE_TOOLKIT=youtube

# Set after discovering the exact publish action in your Composio account.
# Never guess a slug: run the discover command first.
COMPOSIO_INSTAGRAM_PUBLISH_TOOL=
COMPOSIO_TIKTOK_PUBLISH_TOOL=
COMPOSIO_YOUTUBE_PUBLISH_TOOL=

# Optional MT5/Claude application settings. Keep credentials out of Git.
MT5_LOGIN=
MT5_SERVER=
MT5_TERMINAL_PATH=
ANTHROPIC_API_KEY=
